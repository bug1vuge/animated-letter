# Response headers for Netlify and Cloudflare Pages.
# (Vercel reads vercel.json; GitHub Pages cannot set headers and relies on
# the robots meta tags in each page plus robots.txt.)

/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/audio/*
  Cache-Control: public, max-age=86400
